{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yeonjae.studio/schemas/proposition.schema.json",
  "title": "Proposition",
  "description": "Atomic canonical statement that can be known, suspected, believed falsely, or kept secret. Truth is recorded per timeline with validity (ADR-0031).",
  "type": "object",
  "required": [
    "id",
    "project_id",
    "statement",
    "kind",
    "truth"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "project_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "statement": {
      "$ref": "common.schema.json#/$defs/text",
      "description": "English working text"
    },
    "kind": {
      "type": "string",
      "enum": [
        "identity",
        "event",
        "location",
        "ability",
        "intent",
        "relationship",
        "world_rule",
        "secret",
        "other"
      ]
    },
    "truth": {
      "type": "array",
      "minItems": 1,
      "description": "One entry per timeline on which the proposition's truth is asserted; a timeline without an entry inherits from its parent up to the divergence point.",
      "items": {
        "type": "object",
        "required": [
          "timeline_id",
          "value"
        ],
        "additionalProperties": false,
        "properties": {
          "timeline_id": {
            "$ref": "common.schema.json#/$defs/uuid"
          },
          "value": {
            "type": "string",
            "enum": [
              "true",
              "false",
              "unknown"
            ]
          },
          "valid_from": {
            "$ref": "common.schema.json#/$defs/storyClock"
          },
          "valid_to": {
            "oneOf": [
              {
                "$ref": "common.schema.json#/$defs/storyClock"
              },
              {
                "type": "null"
              }
            ]
          },
          "asserted_at_version": {
            "type": "integer",
            "minimum": 0
          },
          "retracted_at_version": {
            "type": [
              "integer",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/evidenceRef"
            }
          }
        }
      }
    },
    "linked_fact_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/uuid"
      }
    },
    "linked_event_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/uuid"
      }
    },
    "entity_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/uuid"
      }
    },
    "secret": {
      "$ref": "#/$defs/secret"
    },
    "created_commit_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "created_in_chapter_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    }
  },
  "$defs": {
    "secret": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "owner_ids",
            "allowed_knower_ids"
          ],
          "additionalProperties": false,
          "properties": {
            "owner_ids": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/uuid"
              },
              "minItems": 1
            },
            "allowed_knower_ids": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/uuid"
              }
            },
            "reader_may_know": {
              "type": "boolean",
              "default": true
            },
            "reveal_plan_ref": {
              "type": "string",
              "description": "Plan item id for the planned reveal"
            },
            "reveal_not_before_chapter": {
              "type": "integer",
              "minimum": 1
            },
          "reader_reveal_chapter": {"type": "integer", "minimum": 1, "description": "ADR-0086 (U1): the chapter from which the READER may learn the secret; reveal_not_before_chapter is the chapter from which other characters may. Absent: the first-person narrator's own secrets are reader-visible from chapter 1, others at reveal_not_before_chapter."},
          "true_from_chapter": {"type": "integer", "minimum": 1, "description": "ADR-0086 (U3): the chapter from which the secret is true in the story (a state that arises later); its knowers know it from then. Absent: true from the start."},
          "layer": {"type": "string", "enum": ["current", "prior_loop", "source_work"], "description": "ADR-0086 (U1): knowledge layer — current timeline, prior-life memory (회귀 전 기억) or source-work knowledge (원작·게임 지식)."}
          }
        }
      ]
    }
  }
}
