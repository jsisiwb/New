{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yeonjae.studio/schemas/series-blueprint.schema.json",
  "title": "Series Blueprint",
  "description": "Top-level plan with committed ending and endgame requirements (FR-3.2).",
  "type": "object",
  "required": ["project_id", "version", "story_promise", "reader_fantasy", "main_conflict", "protagonist_arc", "ending", "endgame_requirements", "seasons"],
  "additionalProperties": false,
  "properties": {
    "project_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "version": { "type": "integer", "minimum": 1 },
    "pinned": { "$ref": "common.schema.json#/$defs/versionRef" },
    "serial_plan": { "$ref": "#/$defs/serialPlan" },
    "story_promise": { "type": "string" },
    "reader_fantasy": { "type": "string" },
    "main_conflict": { "type": "string" },
    "themes": { "type": "array", "items": { "type": "string" } },
    "protagonist_arc": { "$ref": "#/$defs/characterArc" },
    "character_arcs": { "type": "array", "items": { "$ref": "#/$defs/characterArc" } },
    "relationship_arcs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from_entity_id", "to_entity_id", "start", "end", "milestones"],
        "additionalProperties": false,
        "properties": {
          "from_entity_id": { "$ref": "common.schema.json#/$defs/uuid" },
          "to_entity_id": { "$ref": "common.schema.json#/$defs/uuid" },
          "start": { "type": "string" },
          "end": { "type": "string" },
          "milestones": { "type": "array", "items": { "$ref": "#/$defs/milestone" } },
          "constraints": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "progression_arc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "system_summary": { "type": "string" },
        "milestones": { "type": "array", "items": { "$ref": "#/$defs/milestone" } },
        "cadence_chapters": { "type": "integer", "minimum": 1 }
      }
    },
    "mysteries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "answer_proposition_id", "reveal_window"],
        "additionalProperties": false,
        "properties": {
          "question": { "type": "string" },
          "answer_proposition_id": { "$ref": "common.schema.json#/$defs/uuid" },
          "reveal_window": { "$ref": "#/$defs/chapterWindow" },
          "clue_plan": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "foreshadowing_register": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/uuid" }, "description": "Promise ids with status=planned" },
    "red_herrings": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/uuid" } },
    "ending": {
      "type": "object",
      "required": ["type", "final_state_assertions"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["happy", "bittersweet", "open", "tragic"] },
        "summary": { "type": "string" },
        "final_state_assertions": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "endgame_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement", "kind"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "statement": { "type": "string" },
          "kind": { "type": "string", "enum": ["fact", "knowledge", "relationship", "promise_paid", "progression"] },
          "target_ref": { "type": "string", "description": "proposition/entity/promise id when applicable" },
          "planned_in_arc_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/uuid" } },
          "status": { "type": "string", "enum": ["unplanned", "planned", "satisfied"] }
        }
      }
    },
    "seasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ordinal", "title", "objective", "chapter_range_est"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/uuid" },
          "ordinal": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "objective": { "type": "string" },
          "thesis": { "type": "string" },
          "entry_state": { "type": "string" },
          "exit_state": { "type": "string" },
          "chapter_range_est": { "$ref": "#/$defs/chapterWindow" },
          "promise_ids_opened": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/uuid" } },
          "promise_ids_paid": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/uuid" } }
        }
      }
    },
    "hard_requirement_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement_id", "bound_to"],
        "additionalProperties": false,
        "properties": {
          "requirement_id": { "type": "string" },
          "bound_to": { "type": "string", "description": "season/arc ref or 'all'" }
        }
      }
    }
  },
  "$defs": {
    "serialPlan": {
      "type": "object",
      "required": [
        "arrival",
        "episodes",
        "opening_chapters"
      ],
      "additionalProperties": false,
      "properties": {
        "arrival": {
          "type": "object",
          "required": [
            "original_identity",
            "last_memory",
            "first_mismatch",
            "initial_explanation",
            "reality_test",
            "emotional_cost",
            "first_choice"
          ],
          "additionalProperties": false,
          "properties": {
            "original_identity": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "last_memory": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "first_mismatch": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "initial_explanation": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "reality_test": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "emotional_cost": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "first_choice": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "episodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "season_ordinal",
              "chapter_range",
              "title",
              "entry_state",
              "objective",
              "complication",
              "payoff",
              "exit_state",
              "next_pressure"
            ],
            "additionalProperties": false,
            "properties": {
              "season_ordinal": {
                "type": "integer",
                "minimum": 1
              },
              "chapter_range": {
                "$ref": "#/$defs/chapterWindow"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "entry_state": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "objective": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "complication": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "payoff": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "exit_state": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "next_pressure": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        "opening_chapters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "chapter",
              "entry_state",
              "central_situation",
              "reader_discovery",
              "choice",
              "local_payoff",
              "exit_state",
              "next_hook"
            ],
            "additionalProperties": false,
            "properties": {
              "chapter": {
                "type": "integer",
                "minimum": 1
              },
              "entry_state": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "central_situation": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "reader_discovery": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "choice": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "local_payoff": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "exit_state": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "next_hook": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    },
    "characterArc": {
      "type": "object",
      "required": ["entity_id", "start_state", "end_state", "turning_points"],
      "additionalProperties": false,
      "properties": {
        "entity_id": { "$ref": "common.schema.json#/$defs/uuid" },
        "start_state": { "type": "string" },
        "end_state": { "type": "string" },
        "turning_points": { "type": "array", "items": { "$ref": "#/$defs/milestone" }, "minItems": 1 }
      }
    },
    "milestone": {
      "type": "object",
      "required": ["description", "window"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "window": { "$ref": "#/$defs/chapterWindow" },
        "status": { "type": "string", "enum": ["planned", "realized", "unrealized"] }
      }
    },
    "chapterWindow": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": { "from": { "type": "integer", "minimum": 1 }, "to": { "type": "integer", "minimum": 1 } }
    }
  }
}
