# Variable NAMES only — never put values in the repository (AGENTS.md rule 5).
# Real values live in the secret manager and are injected at boot.

# --- Core services ---
DATABASE_URL=
DATABASE_MIGRATION_URL=
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
KMS_KEY_REF=
NLP_SIDECAR_URL=

# --- Model provider (ADR-0051). No default reaches a paid provider. ---
# replay = recorded fixtures (needs YEONJAE_REPLAY_FILE); genspark = the local bridge; live = a real API.
YEONJAE_PROVIDER_MODE=
YEONJAE_REPLAY_FILE=
# live: openai (any OpenAI-compatible /chat/completions endpoint: OpenAI, OpenRouter, Groq, DeepSeek,
# Gemini's OpenAI-compatible endpoint, vLLM/Ollama) or anthropic (Messages API).
YEONJAE_LIVE_PROVIDER=
YEONJAE_LIVE_API_KEY=
# Optional. Defaults: https://api.openai.com/v1 or https://api.anthropic.com
YEONJAE_LIVE_BASE_URL=
# Model per class: R = requirements/planning/bible, P = prose, M = evaluation, C = checking.
# Unset classes fall back to YEONJAE_MODEL_DEFAULT.
YEONJAE_MODEL_DEFAULT=
YEONJAE_MODEL_R=
YEONJAE_MODEL_P=
YEONJAE_MODEL_M=
YEONJAE_MODEL_C=
# Optional prices (cents per million tokens) so the budget ledger prices calls; 0 = unpriced.
YEONJAE_LIVE_PRICE_IN_CENTS_PER_MTOK=
YEONJAE_LIVE_PRICE_OUT_CENTS_PER_MTOK=
YEONJAE_LIVE_TIMEOUT_MS=
# Optional second provider tried when the primary fails with a retryable class.
YEONJAE_LIVE_FALLBACK_PROVIDER=
YEONJAE_LIVE_FALLBACK_API_KEY=
YEONJAE_LIVE_FALLBACK_BASE_URL=
YEONJAE_FALLBACK_MODEL_DEFAULT=
# Budget ceiling in cents when shared enforcement (migration 0015 policies) is not used.
YEONJAE_BUDGET_CENTS=
# inline (default) = the API process also drives novel runs; external = only @yeonjae/worker start:novel does.
YEONJAE_NOVEL_RUNNER=
EMBEDDING_PROVIDER_BASE_URL=
EMBEDDING_PROVIDER_API_KEY=

# --- App ---
APP_BASE_URL=
# Comma-separated exact origins allowed to make credentialed cross-origin requests.
# Empty or unset = deny all cross-origin access (same-origin still works). "*" is rejected at startup,
# because this API authenticates with cookies. Example: https://studio.example.com,http://localhost:5173
YEONJAE_CORS_ORIGINS=
# Comma-separated proxy addresses whose X-Forwarded-For may be trusted for rate-limit client identity.
# Empty = ignore the header entirely and key limits on the socket address.
YEONJAE_TRUSTED_PROXIES=
# Base URL of the /v1 API for the operator web app. Empty = same origin, which needs no CORS grant at all.
# Set this only when the web app is served from a different origin, and add that origin to
# YEONJAE_CORS_ORIGINS (which is default-deny).
NEXT_PUBLIC_API_BASE_URL=
SESSION_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OTEL_EXPORTER_OTLP_ENDPOINT=
