# Variable NAMES only — never put values in the repository (AGENTS.md rule 5).
# Real values live in the secret manager and are injected at boot.

# --- Core services ---
DATABASE_URL=
DATABASE_MIGRATION_URL=
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
KMS_KEY_REF=
NLP_SIDECAR_URL=

# --- Model providers (any subset; routing table decides usage) ---
LLM_PROVIDER_A_BASE_URL=
LLM_PROVIDER_A_API_KEY=
LLM_PROVIDER_B_BASE_URL=
LLM_PROVIDER_B_API_KEY=
EMBEDDING_PROVIDER_BASE_URL=
EMBEDDING_PROVIDER_API_KEY=

# --- App ---
APP_BASE_URL=
# Comma-separated exact origins allowed to make credentialed cross-origin requests.
# Empty or unset = deny all cross-origin access (same-origin still works). "*" is rejected at startup,
# because this API authenticates with cookies. Example: https://studio.example.com,http://localhost:5173
YEONJAE_CORS_ORIGINS=
# Comma-separated proxy addresses whose X-Forwarded-For may be trusted for rate-limit client identity.
# Empty = ignore the header entirely and key limits on the socket address.
YEONJAE_TRUSTED_PROXIES=
# Base URL of the /v1 API for the operator web app. Empty = same origin, which needs no CORS grant at all.
# Set this only when the web app is served from a different origin, and add that origin to
# YEONJAE_CORS_ORIGINS (which is default-deny).
NEXT_PUBLIC_API_BASE_URL=
SESSION_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OTEL_EXPORTER_OTLP_ENDPOINT=
