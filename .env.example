# Variable NAMES only — never put values in the repository (AGENTS.md rule 5).
# Real values live in the secret manager and are injected at boot.

# --- Core services ---
DATABASE_URL=
DATABASE_MIGRATION_URL=
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
KMS_KEY_REF=
NLP_SIDECAR_URL=

# --- Model provider (ADR-0051). No default reaches a paid provider. ---
# replay = recorded fixtures (needs YEONJAE_REPLAY_FILE); genspark = the local bridge; notion = the Notion
# AI bridge; live = a real API.
YEONJAE_PROVIDER_MODE=
YEONJAE_REPLAY_FILE=
# notion = the operator's Notion AI bridge (same /v1/complete protocol; path-prefixed URL allowed).
YEONJAE_NOTION_URL=
YEONJAE_NOTION_TOKEN=
# Leave empty: the adapter's default (1,260,000 ms) outlasts the bridge's own failover (two 600 s workspace
# attempts). A shorter value aborts a slow call exactly when the bridge moves it to the second workspace.
YEONJAE_NOTION_TIMEOUT_MS=
# Optional: pooled model id (default notion-ai) and comma-separated fallback route models.
YEONJAE_NOTION_MODEL=
YEONJAE_NOTION_FALLBACK_MODELS=
# live: openai (any OpenAI-compatible /chat/completions endpoint: OpenAI, OpenRouter, Groq, DeepSeek,
# Gemini's OpenAI-compatible endpoint, vLLM/Ollama) or anthropic (Messages API).
YEONJAE_LIVE_PROVIDER=
YEONJAE_LIVE_API_KEY=
# Optional. Defaults: https://api.openai.com/v1 or https://api.anthropic.com
YEONJAE_LIVE_BASE_URL=
# Model per class: R = requirements/planning/bible, P = prose, M = evaluation, C = checking.
# Unset classes fall back to YEONJAE_MODEL_DEFAULT.
YEONJAE_MODEL_DEFAULT=
YEONJAE_MODEL_R=
YEONJAE_MODEL_P=
YEONJAE_MODEL_M=
YEONJAE_MODEL_C=
# Optional prices (cents per million tokens) so the budget ledger prices calls; 0 = unpriced.
YEONJAE_LIVE_PRICE_IN_CENTS_PER_MTOK=
YEONJAE_LIVE_PRICE_OUT_CENTS_PER_MTOK=
YEONJAE_LIVE_TIMEOUT_MS=
# Optional: json_schema sends each JSON role's answer schema as the provider's native response format
# (OpenAI-compatible endpoints that support it, ADR-0057); json_object (default) keeps plain JSON mode.
YEONJAE_LIVE_STRUCTURED_OUTPUT=
# Optional second provider tried when the primary fails with a retryable class.
YEONJAE_LIVE_FALLBACK_PROVIDER=
YEONJAE_LIVE_FALLBACK_API_KEY=
YEONJAE_LIVE_FALLBACK_BASE_URL=
YEONJAE_LIVE_FALLBACK_STRUCTURED_OUTPUT=
YEONJAE_FALLBACK_MODEL_DEFAULT=
# Budget ceiling in cents when shared enforcement (migration 0015 policies) is not used.
YEONJAE_BUDGET_CENTS=
# genspark mode: the operator's bridge (loopback default unless the URL is set) and its token and deadline.
YEONJAE_GENSPARK_URL=
YEONJAE_GENSPARK_TOKEN=
YEONJAE_GENSPARK_TIMEOUT_MS=
# Budget and rate enforcement: shared (Postgres ledgers, the worker's default) or isolated_test (tests only).
YEONJAE_ENFORCEMENT_MODE=
# Milliseconds a call may wait for a rate-limit slot before failing retryable (0 = do not wait).
YEONJAE_RATE_MAX_WAIT_MS=
# inline (default) = the API process also drives novel runs; external = only @yeonjae/worker start:novel does.
YEONJAE_NOVEL_RUNNER=
# Novel runner poll interval and the runner/worker identity recorded on leases (defaults: 3000 ms, the pid).
YEONJAE_NOVEL_POLL_MS=
YEONJAE_WORKER_ID=
# Graceful shutdown: drain deadline and telemetry flush (API 15000/2000 ms, worker 30000/2000 ms).
YEONJAE_DRAIN_DEADLINE_MS=
YEONJAE_TELEMETRY_FLUSH_MS=
# Worker health endpoint port (0 = off) and the Temporal task queue override.
YEONJAE_WORKER_HEALTH_PORT=
TEMPORAL_TASK_QUEUE=
EMBEDDING_PROVIDER_BASE_URL=
EMBEDDING_PROVIDER_API_KEY=

# --- App ---
APP_BASE_URL=
# Comma-separated exact origins allowed to make credentialed cross-origin requests.
# Empty or unset = deny all cross-origin access (same-origin still works). "*" is rejected at startup,
# because this API authenticates with cookies. Example: https://studio.example.com,http://localhost:5173
YEONJAE_CORS_ORIGINS=
# Comma-separated proxy addresses whose X-Forwarded-For may be trusted for rate-limit client identity.
# Empty = ignore the header entirely and key limits on the socket address.
YEONJAE_TRUSTED_PROXIES=
# Server-side Next.js proxy target for the /v1 API. Defaults to http://localhost:8080.
# This is intentionally not NEXT_PUBLIC: the browser always uses same-origin /v1 requests.
YEONJAE_API_ORIGIN=
# Optional direct API base URL for deployments that deliberately do not use the Next.js proxy.
# Add the web origin to YEONJAE_CORS_ORIGINS (which is default-deny).
NEXT_PUBLIC_API_BASE_URL=
SESSION_SECRET=
# Local development over plain http only: true drops the Secure cookie flag. Never in production.
YEONJAE_INSECURE_COOKIES=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OTEL_EXPORTER_OTLP_ENDPOINT=
